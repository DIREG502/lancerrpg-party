<section class="tab lp-tab lp-tab-squad {{tab.cssClass}}" data-tab="squad" data-group="primary">
  {{#if limited}}
  <div class="lp-section-bar lp-bar-secondary"><span class="lp-section-title">{{localize "LANCERPARTY.Tab.squad"}}</span></div>
  <ul class="lp-limited-list">
    {{#each members as |m|}}{{#unless m.missing}}
    <li class="lp-row"><img src="{{m.img}}" alt=""> <span class="lp-row-title">{{m.name}}</span>{{#if m.callsign}} <span class="lp-row-sub">“{{m.callsign}}”</span>{{/if}}</li>
    {{/unless}}{{/each}}
  </ul>
  {{else}}

  {{#if hasMissing}}
  <div class="lp-notice">
    <i class="fa-solid fa-triangle-exclamation"></i> <span>{{localize "LANCERPARTY.Member.MissingNotice"}}</span>
    {{#if manage}}<button type="button" class="lp-chip-button" data-action="pruneMissing">{{localize "LANCERPARTY.Member.Prune"}}</button>{{/if}}
  </div>
  {{/if}}

  {{#each members as |m|}}
  {{#unless m.missing}}
  <article class="lp-member{{#if m.mech.destroyed}} lp-destroyed{{/if}}{{#if m.isNpc}} lp-member-npc{{/if}}" data-member-uuid="{{m.uuid}}" data-drag-uuid="{{m.uuid}}">
    <header class="lp-section-bar {{#if m.isNpc}}lp-bar-neutral{{else}}lp-bar-secondary{{/if}}">
      <span class="lp-section-title">{{#if m.canOpen}}<a data-action="openMember" data-uuid="{{m.uuid}}">{{m.name}}</a>{{else}}{{m.name}}{{/if}}</span>
      {{#if m.callsign}}<span class="lp-section-tag">{{m.callsign}}</span>{{/if}}
      <span class="lp-section-right">
        {{#if m.isPilot}}<span class="lp-section-ll">{{localize "LANCERPARTY.Member.LL" level=m.level}}</span>{{else}}<span class="lp-section-ll">{{m.typeLabel}}{{#if m.tier}} · {{localize "LANCERPARTY.Member.NpcTier" tier=m.tier}}{{/if}}</span>{{/if}}
        {{#if @root.manage}}<a class="lp-bar-icon" data-action="removeMember" data-tooltip="LANCERPARTY.Member.Remove" aria-label="{{localize "LANCERPARTY.Member.Remove"}}"><i class="fa-solid fa-user-minus"></i></a>{{/if}}
      </span>
    </header>

    <div class="lp-member-body">
      {{!-- Art column: mech (or the member itself) with size and speed --}}
      <div class="lp-member-art"{{#if m.mech}} data-drag-uuid="{{m.mech.uuid}}"{{/if}}>
        {{#if m.mech}}
        <img src="{{m.mech.img}}" alt="{{m.mech.name}}" {{#if (or m.canOpenMech (and (not m.isPilot) m.canOpen))}}data-action="openMember" data-uuid="{{m.mech.uuid}}"{{/if}}>
        {{#if m.mech.stats.size}}<div class="lp-size-badge" data-tooltip="LANCERPARTY.Stat.Size"><small>{{localize "LANCERPARTY.Stat.SizeShort"}}</small><span>{{m.mech.stats.size}}</span></div>{{/if}}
        {{#unless m.restricted}}{{#if m.mech.stats.speed}}<div class="lp-speed" data-tooltip="LANCERPARTY.Stat.Speed"><i class="fa-solid fa-circle-right"></i> {{m.mech.stats.speed}}</div>{{/if}}{{/unless}}
        {{else}}
        <img src="{{m.img}}" alt="{{m.name}}" {{#if m.canOpen}}data-action="openMember" data-uuid="{{m.uuid}}"{{/if}}>
        {{/if}}
      </div>

      {{!-- Main column: mech telemetry --}}
      <div class="lp-member-main">
        {{#if m.mech}}
        <div class="lp-item-title">
          {{#if (or m.canOpenMech (and (not m.isPilot) m.canOpen))}}<a class="lp-item-name" data-action="openMember" data-uuid="{{m.mech.uuid}}">{{m.mech.name}}</a>{{else}}<span class="lp-item-name">{{m.mech.name}}</span>{{/if}}
          <small>{{#if m.mech.frame}}{{m.mech.frame}}{{else}}{{m.typeLabel}}{{/if}}</small>
          {{#if (and m.isPilot (not m.mechLinked))}}<i class="fa-solid fa-link-slash lp-warn" data-tooltip="LANCERPARTY.Member.LinkBroken"></i>{{/if}}
          {{#if m.mech.coreActive}}<span class="lp-chip lp-chip-core">{{localize "LANCERPARTY.Stat.CoreActive"}}</span>{{/if}}
          {{#if m.mech.destroyed}}<span class="lp-chip lp-chip-bad">{{localize "LANCERPARTY.Summary.Destroyed"}}</span>{{/if}}
        </div>
        {{#unless m.restricted}}
        <div class="lp-meters">
          <div class="lp-meter-pair">
            <div class="lp-meter-labels"><span>{{localize "LANCERPARTY.Stat.HP"}}</span>{{#if m.mech.structure}}<span>{{localize "LANCERPARTY.Side.Struct"}}</span>{{/if}}</div>
            <div class="lp-meter-stack">
              {{#if m.mech.hp}}<div class="lp-meter lp-meter-hp" style="--lp-fill: {{m.mech.hp.pct}}%"><span>{{m.mech.hp.value}}/{{m.mech.hp.max}}</span></div>{{/if}}
              {{#if m.mech.structure}}<div class="lp-meter lp-meter-structure" style="--lp-fill: {{m.mech.structure.pct}}%"><span>{{m.mech.structure.value}}/{{m.mech.structure.max}}</span></div>{{/if}}
            </div>
            <div class="lp-meter-box lp-box-shield" data-tooltip="LANCERPARTY.Stat.Overshield"><span>{{m.mech.overshield}}</span><small>{{localize "LANCERPARTY.Side.Shld"}}</small></div>
          </div>
          <div class="lp-meter-pair">
            <div class="lp-meter-labels"><span>{{localize "LANCERPARTY.Stat.Heat"}}</span>{{#if m.mech.stress}}<span>{{localize "LANCERPARTY.Stat.StressShort"}}</span>{{/if}}</div>
            <div class="lp-meter-stack">
              {{#if m.mech.heat}}<div class="lp-meter lp-meter-heat" style="--lp-fill: {{m.mech.heat.pct}}%"><span>{{m.mech.heat.value}}/{{m.mech.heat.max}}</span></div>{{/if}}
              {{#if m.mech.stress}}<div class="lp-meter lp-meter-stress" style="--lp-fill: {{m.mech.stress.pct}}%"><span>{{m.mech.stress.value}}/{{m.mech.stress.max}}</span></div>{{/if}}
            </div>
            <div class="lp-meter-box lp-box-burn" data-tooltip="LANCERPARTY.Stat.Burn"><span>{{m.mech.burn}}</span><small>{{localize "LANCERPARTY.Side.Burn"}}</small></div>
          </div>
        </div>
        <div class="lp-statline lp-statline-compact">
          <div class="lp-stat" data-tooltip="LANCERPARTY.Stat.Armor"><i class="cci cci-role-defender"></i><span class="lp-stat-value">{{m.mech.stats.armor}}</span><span class="lp-stat-label">{{localize "LANCERPARTY.Stat.ArmorShort"}}</span></div>
          <div class="lp-stat" data-tooltip="LANCERPARTY.Stat.Evasion"><i class="cci cci-evasion"></i><span class="lp-stat-value">{{m.mech.stats.evasion}}</span><span class="lp-stat-label">{{localize "LANCERPARTY.Stat.EvasionShort"}}</span></div>
          <div class="lp-stat" data-tooltip="LANCERPARTY.Stat.EDef"><i class="cci cci-edef"></i><span class="lp-stat-value">{{m.mech.stats.edef}}</span><span class="lp-stat-label">{{localize "LANCERPARTY.Stat.EDefShort"}}</span></div>
          <div class="lp-stat" data-tooltip="LANCERPARTY.Stat.TechAttack"><i class="cci cci-tech-quick"></i><span class="lp-stat-value">{{m.mech.stats.techAttack}}</span><span class="lp-stat-label">{{localize "LANCERPARTY.Stat.TechShort"}}</span></div>
          <div class="lp-stat" data-tooltip="LANCERPARTY.Stat.Save"><i class="cci cci-save"></i><span class="lp-stat-value">{{m.mech.stats.save}}</span><span class="lp-stat-label">{{localize "LANCERPARTY.Stat.SaveShort"}}</span></div>
          <div class="lp-stat" data-tooltip="LANCERPARTY.Stat.Sensors"><i class="cci cci-sensor"></i><span class="lp-stat-value">{{m.mech.stats.sensors}}</span><span class="lp-stat-label">{{localize "LANCERPARTY.Stat.SensorsShort"}}</span></div>
        </div>
        <div class="lp-counters">
          {{#if m.mech.repairs}}
          <span class="lp-counter" data-tooltip="LANCERPARTY.Stat.Repairs"><i class="cci cci-repair"></i>
            {{#if m.mech.repairPips}}{{#each m.mech.repairPips as |p|}}<span class="lp-pip{{#if p.filled}} filled{{/if}}"></span>{{/each}}{{else}}{{m.mech.repairs.value}}/{{m.mech.repairs.max}}{{/if}}
          </span>
          {{/if}}
          {{#if (ne m.mech.coreEnergy null)}}
          <span class="lp-counter lp-counter-core{{#if m.mech.coreEnergy}} charged{{/if}}" data-tooltip="LANCERPARTY.Stat.CorePower"><i class="cci cci-corebonus"></i>
            {{#if m.mech.coreEnergy}}{{localize "LANCERPARTY.Stat.CoreReady"}}{{else}}{{localize "LANCERPARTY.Stat.CoreSpent"}}{{/if}}
          </span>
          {{/if}}
          {{#if m.mech.overcharge}}<span class="lp-counter" data-tooltip="LANCERPARTY.Stat.Overcharge"><i class="cci cci-overcharge"></i> {{m.mech.overcharge}}</span>{{/if}}
          {{#each m.mech.statuses as |s|}}<img class="lp-status" src="{{s.img}}" alt="{{s.label}}" data-tooltip="{{s.label}}">{{/each}}
        </div>
        {{/unless}}
        {{else if m.isPilot}}
        <div class="lp-empty-slot"><i class="cci cci-pilot"></i> {{localize "LANCERPARTY.Member.NoMech"}}</div>
        {{/if}}
      </div>

      {{!-- Pilot column: grit + HASE hexes, pilot HP, role --}}
      {{#if m.isPilot}}
      <div class="lp-member-pilot">
        {{#unless m.restricted}}
        <div class="lp-hex-cluster lp-hex-cluster-hase">
          <div class="lp-hex lp-hex-grit" data-tooltip="LANCERPARTY.Stat.Grit"><div class="lp-hex-inner"><span class="lp-hex-label">{{localize "LANCERPARTY.Stat.GritShort"}}</span><span class="lp-hex-value">+{{m.grit}}</span></div></div>
          <div class="lp-hex lp-hex-sm" data-tooltip="LANCERPARTY.HASE.hull"><div class="lp-hex-inner"><span class="lp-hex-label">{{localize "LANCERPARTY.HASEShort.hull"}}</span><span class="lp-hex-value">{{m.hase.hull}}</span></div></div>
          <div class="lp-hex lp-hex-sm" data-tooltip="LANCERPARTY.HASE.agi"><div class="lp-hex-inner"><span class="lp-hex-label">{{localize "LANCERPARTY.HASEShort.agi"}}</span><span class="lp-hex-value">{{m.hase.agi}}</span></div></div>
          <div class="lp-hex lp-hex-sm" data-tooltip="LANCERPARTY.HASE.sys"><div class="lp-hex-inner"><span class="lp-hex-label">{{localize "LANCERPARTY.HASEShort.sys"}}</span><span class="lp-hex-value">{{m.hase.sys}}</span></div></div>
          <div class="lp-hex lp-hex-sm" data-tooltip="LANCERPARTY.HASE.eng"><div class="lp-hex-inner"><span class="lp-hex-label">{{localize "LANCERPARTY.HASEShort.eng"}}</span><span class="lp-hex-value">{{m.hase.eng}}</span></div></div>
        </div>
        {{/unless}}
        <div class="lp-pilot-card">
          <img class="lp-pilot-portrait" src="{{m.img}}" alt="{{m.name}}" {{#if m.canOpen}}data-action="openMember" data-uuid="{{m.uuid}}"{{/if}}>
          <div class="lp-pilot-info">
            {{#if m.playerName}}<span class="lp-pilot-player"><i class="fa-solid fa-user"></i> {{m.playerName}}</span>{{/if}}
            {{#if (and m.hp (not m.restricted))}}
            <div class="lp-meter lp-meter-hp lp-meter-thin" style="--lp-fill: {{m.hp.pct}}%" data-tooltip="LANCERPARTY.Stat.PilotHP"><span>{{m.hp.value}}/{{m.hp.max}}</span></div>
            {{/if}}
            {{#unless m.restricted}}{{#each m.statuses as |s|}}<img class="lp-status" src="{{s.img}}" alt="{{s.label}}" data-tooltip="{{s.label}}">{{/each}}{{/unless}}
          </div>
        </div>
        {{#if m.canEditRole}}
        <input type="text" class="lp-role" value="{{m.role}}" data-lp-change="role" data-uuid="{{m.uuid}}" data-lp-contrib
               placeholder="{{localize "LANCERPARTY.Member.RolePlaceholder"}}" aria-label="{{localize "LANCERPARTY.Member.Role"}}">
        {{else if m.role}}
        <span class="lp-role lp-role-text">{{m.role}}</span>
        {{/if}}
      </div>
      {{else if m.canEditRole}}
      <div class="lp-member-pilot lp-member-pilot-slim">
        <input type="text" class="lp-role" value="{{m.role}}" data-lp-change="role" data-uuid="{{m.uuid}}" data-lp-contrib
               placeholder="{{localize "LANCERPARTY.Member.RolePlaceholder"}}" aria-label="{{localize "LANCERPARTY.Member.Role"}}">
      </div>
      {{/if}}
    </div>
  </article>
  {{/unless}}
  {{else}}
  <div class="lp-empty-state"><i class="fa-solid fa-users-slash"></i><p>{{localize "LANCERPARTY.Member.None"}}</p></div>
  {{/each}}
  {{#if manage}}<p class="lp-hint"><i class="fa-solid fa-hand-pointer"></i> {{localize "LANCERPARTY.Member.DropHint"}}</p>{{/if}}
  {{/if}}
</section>
