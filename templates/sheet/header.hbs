<header class="lp-header">
  <div class="lp-header-art" aria-hidden="true">
    <img src="{{party.img}}" alt="">
  </div>
  <div class="lp-header-main">
    {{#if editable}}
    <input class="lp-header-name" type="text" name="name" value="{{party.name}}"
           placeholder="{{localize "LANCERPARTY.Sheet.NamePlaceholder"}}" aria-label="{{localize "LANCERPARTY.Sheet.NamePlaceholder"}}">
    {{else}}
    <h1 class="lp-header-name">{{party.name}}</h1>
    {{/if}}
    <div class="lp-header-sub">
      <span>{{localize "LANCERPARTY.TypeLabel"}}</span>
      {{#if isActive}}
      <span class="lp-header-flag"><i class="fa-solid fa-star"></i> {{localize "LANCERPARTY.Sidebar.Active"}}</span>
      {{else if isGM}}
      <button type="button" class="lp-header-flag lp-flag-button" data-action="setActive"><i class="fa-regular fa-star"></i> {{localize "LANCERPARTY.Sidebar.SetActive"}}</button>
      {{/if}}
    </div>
    {{#unless limited}}
    <div class="lp-terminal">
      <div>&gt; {{localize "LANCERPARTY.Terminal.Roster" members=summary.members pilots=summary.pilots mechs=summary.mechs}}</div>
      <div>&gt; {{localize "LANCERPARTY.Terminal.Mission" number=system.mission.number status=missionStatusLabel}}{{#if system.mission.name}} // {{system.mission.name}}{{/if}}{{#if system.mission.sitrep}} // {{system.mission.sitrep}}{{/if}}</div>
      <div class="lp-prompt">&gt;//: <span class="lp-cursor">_</span></div>
    </div>
    {{/unless}}
  </div>
  <div class="lp-header-side">
    {{#if editable}}
    <button type="button" class="lp-icon-button" data-action="editImage" data-edit="img" data-tooltip="LANCERPARTY.Sheet.EditImage" aria-label="{{localize "LANCERPARTY.Sheet.EditImage"}}"><i class="fa-solid fa-image"></i></button>
    {{/if}}
  </div>
  <nav class="lp-tabs" aria-label="{{localize "LANCERPARTY.Sheet.Tabs"}}">
    {{#each tabs as |t|}}
    <a class="lp-tab-button {{t.cssClass}}" data-action="tab" data-group="primary" data-tab="{{t.id}}"><i class="{{t.icon}}" inert></i> <span>{{localize t.label}}</span></a>
    {{/each}}
  </nav>
</header>
