<div class="lancer-party-card lp-roster">
  <header class="lp-card-bar"><img src="{{party.img}}" alt="" width="22" height="22"><span class="lp-card-title">{{party.name}}</span></header>
  <ul class="lp-roster-rows">
    {{#each members as |m|}}
    <li>
      <div class="lp-roster-name"><strong>{{m.name}}</strong>{{#if m.callsign}} <span class="lp-roster-callsign">{{m.callsign}}</span>{{/if}}{{#if m.isPilot}} <span class="lp-roster-ll">{{localize "LANCERPARTY.Member.LL" level=m.level}}</span>{{/if}}</div>
      {{#if m.mech}}
      <div class="lp-roster-mech">
        {{m.mech.name}}{{#if m.mech.frame}} ({{m.mech.frame}}){{/if}}
        {{#if m.mech.hp}} · {{localize "LANCERPARTY.Stat.HP"}} {{m.mech.hp.value}}/{{m.mech.hp.max}}{{/if}}
        {{#if m.mech.structure}} · {{localize "LANCERPARTY.Stat.StructureShort"}} {{m.mech.structure.value}}/{{m.mech.structure.max}}{{/if}}
        {{#if m.mech.stress}} · {{localize "LANCERPARTY.Stat.StressShort"}} {{m.mech.stress.value}}/{{m.mech.stress.max}}{{/if}}
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ul>
</div>
